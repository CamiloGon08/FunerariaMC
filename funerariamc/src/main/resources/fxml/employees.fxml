<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
  Módulo de Personal (HU-02, HU-03, HU-04, HU-06, HU-07), propuesta P-08 / P-08.1:
  filtros por área, indicadores, tarjetas por empleado y panel lateral de detalle.
  Se muestra dentro del contentPane de main.fxml.
-->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="root" fx:controller="com.example.funerariamc.controller.EmployeeController"
           styleClass="personal-root" stylesheets="@../css/personal.css">

    <fx:define>
        <ToggleGroup fx:id="areaGroup"/>
    </fx:define>

    <VBox spacing="18">
        <!-- Búsqueda, áreas, estado y registrar (.filter-card y .search-box en app.css) -->
        <HBox fx:id="filterBar" styleClass="filter-card">
            <HBox styleClass="search-box" HBox.hgrow="ALWAYS" minWidth="150">
                <SVGPath content="M7 1.5a5.5 5.5 0 1 1 0 11a5.5 5.5 0 0 1 0-11z M11.2 11.2 L15 15" styleClass="search-icon"/>
                <TextField fx:id="searchField" promptText="Buscar por nombre o cédula" HBox.hgrow="ALWAYS"/>
            </HBox>
            <!-- Los chips de área se agregan desde el controlador (uno por área) -->
            <HBox fx:id="areaChips" spacing="5" alignment="CENTER_LEFT" minWidth="-Infinity"/>
            <ComboBox fx:id="statusFilter" styleClass="chip-combo" prefWidth="118" minWidth="118"/>
            <Button text="+  Registrar empleado" onAction="#onRegister" styleClass="primary-button"
                    minWidth="-Infinity"/>
        </HBox>

        <!-- Indicadores -->
        <HBox spacing="16">
            <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label text="ACTIVOS" styleClass="kpi-caption"/>
                <Label fx:id="activeValue" text="—" styleClass="kpi-value"/>
                <Label fx:id="activeDetail" styleClass="kpi-detail"/>
            </VBox>
            <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label text="CON CUENTA DE ACCESO" styleClass="kpi-caption"/>
                <Label fx:id="accountsValue" text="—" styleClass="kpi-value"/>
                <Label text="administración, secretaría y ventas" styleClass="kpi-detail"/>
            </VBox>
            <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label text="DOCUMENTOS POR VENCER" styleClass="kpi-caption"/>
                <Label fx:id="expiringValue" text="—" styleClass="kpi-value"/>
                <Label fx:id="expiringDetail" text="licencias en los próximos 30 días" styleClass="kpi-detail"/>
            </VBox>
            <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label text="INACTIVOS" styleClass="kpi-caption"/>
                <Label fx:id="inactiveValue" text="—" styleClass="kpi-value"/>
                <Label text="no se borran (RN-19)" styleClass="kpi-detail"/>
            </VBox>
        </HBox>

        <HBox alignment="BOTTOM_LEFT">
            <Label text="Equipo" styleClass="section-heading"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="showingLabel" styleClass="card-subtitle"/>
        </HBox>

        <!-- Tarjetas: barra de desplazamiento visible; se cargan 12 más al llegar al final -->
        <ScrollPane fx:id="cardScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS"
                    styleClass="card-scroll" VBox.vgrow="ALWAYS">
            <VBox spacing="16" styleClass="card-scroll-content">
                <GridPane fx:id="cardGrid" hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                    </columnConstraints>
                </GridPane>
                <Label fx:id="emptyLabel" text="No hay empleados que coincidan con la búsqueda."
                       styleClass="card-subtitle" managed="false" visible="false"/>
                <HBox alignment="CENTER">
                    <Button fx:id="moreButton" text="Mostrar más empleados" onAction="#onLoadMore"
                            styleClass="secondary-button" managed="false" visible="false"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </VBox>

    <!-- Panel de detalle (P-08.1): velo que oscurece la lista y panel a la derecha -->
    <Region fx:id="veil" styleClass="drawer-veil" visible="false" onMouseClicked="#onCloseDrawer"/>
    <VBox fx:id="drawer" styleClass="drawer" StackPane.alignment="CENTER_RIGHT"
          prefWidth="440" maxWidth="440" visible="false">
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="card-scroll" VBox.vgrow="ALWAYS">
            <VBox fx:id="drawerBody" spacing="14" styleClass="drawer-body"/>
        </ScrollPane>
        <HBox fx:id="drawerActions" spacing="10" styleClass="drawer-footer"/>
    </VBox>
</StackPane>
