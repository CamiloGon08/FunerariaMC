<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Módulo de Personal (HU-02, HU-03, HU-04). Se muestra dentro del contentPane de main.fxml. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.funerariamc.controller.EmployeeController"
      spacing="20" styleClass="personal-root" stylesheets="@../css/personal.css">

    <fx:define>
        <ToggleGroup fx:id="statusGroup"/>
    </fx:define>

    <!-- Búsqueda y filtros: cápsula de búsqueda compartida con la bitácora (.filter-card y .search-box en app.css) -->
    <HBox styleClass="filter-card">
        <HBox styleClass="search-box" HBox.hgrow="ALWAYS" minWidth="230">
            <SVGPath content="M7 1.5a5.5 5.5 0 1 1 0 11a5.5 5.5 0 0 1 0-11z M11.2 11.2 L15 15" styleClass="search-icon"/>
            <TextField fx:id="searchField" promptText="Buscar nombre o documento" HBox.hgrow="ALWAYS"/>
        </HBox>
        <ToggleButton fx:id="allToggle" text="Todos" toggleGroup="$statusGroup" selected="true" styleClass="chip"/>
        <ToggleButton fx:id="activeToggle" text="Activos" toggleGroup="$statusGroup" styleClass="chip"/>
        <ToggleButton fx:id="inactiveToggle" text="Inactivos" toggleGroup="$statusGroup" styleClass="chip"/>
        <ComboBox fx:id="positionFilter" styleClass="chip-combo" prefWidth="170" minWidth="170"/>
        <Button text="+  Registrar empleado" onAction="#onRegister" styleClass="primary-button"
                minWidth="-Infinity"/>
    </HBox>

    <!-- Tabla de empleados -->
    <VBox styleClass="table-card" spacing="2" VBox.vgrow="ALWAYS">
        <Label text="Empleados registrados" styleClass="card-title"/>
        <Label fx:id="countLabel" styleClass="card-subtitle"/>
        <TableView fx:id="employeeTable" styleClass="employee-table" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets top="12"/>
            </VBox.margin>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="documentColumn" text="DOCUMENTO" prefWidth="115" minWidth="110"/>
                <TableColumn fx:id="nameColumn" text="NOMBRE" prefWidth="200" minWidth="170"/>
                <TableColumn fx:id="positionColumn" text="CARGO" prefWidth="160" minWidth="150"/>
                <TableColumn fx:id="hireDateColumn" text="INGRESO" prefWidth="95" minWidth="95"/>
                <TableColumn fx:id="statusColumn" text="ESTADO" prefWidth="110" minWidth="105"/>
                <TableColumn fx:id="actionsColumn" text="ACCIONES" prefWidth="210" minWidth="210" sortable="false"/>
            </columns>
            <placeholder>
                <Label text="No hay empleados que coincidan con la búsqueda." styleClass="card-subtitle"/>
            </placeholder>
        </TableView>
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="10"/>
            </padding>
            <Label fx:id="showingLabel" styleClass="card-subtitle"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <!-- Solo la barra de páginas (estilo de la bitácora): la tabla de arriba es la que cambia -->
            <Pagination fx:id="pagination" styleClass="log-pagination" pageCount="1" maxPageIndicatorCount="7"/>
        </HBox>
    </VBox>
</VBox>
