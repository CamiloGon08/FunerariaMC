<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
  Módulo Red de funerarias aliadas (solo el Administrador Maestro): banda verde con 4 indicadores,
  buscador por nombre o NIT, filtro por ciudad y por estado, tarjetas de las funerarias y panel lateral
  con el convenio y los pagos. Se muestra dentro del contentPane de main.fxml (RefreshableView).
-->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="root" fx:controller="com.example.funerariamc.controller.AlliedNetworkController"
           styleClass="personal-root,allied-root" stylesheets="@../css/personal.css, @../css/allied-network.css">

    <fx:define>
        <ToggleGroup fx:id="stateGroup"/>
    </fx:define>

    <VBox spacing="16">
        <!-- Banda verde: arriba el encabezado del menú (MainController lo pone en #heroHeaderSlot) -->
        <VBox styleClass="hero-band" spacing="18">
            <StackPane id="heroHeaderSlot" alignment="TOP_LEFT"/>
            <HBox spacing="16">
                <VBox styleClass="hero-kpi,highlight" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label text="ALIADAS ACTIVAS" styleClass="hero-kpi-caption"/>
                    <Label fx:id="activeValue" text="—" styleClass="hero-kpi-value"/>
                    <Label fx:id="activeDetail" styleClass="hero-kpi-detail"/>
                </VBox>
                <VBox styleClass="hero-kpi" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label text="SERVICIOS ESTE MES" styleClass="hero-kpi-caption"/>
                    <Label fx:id="servicesValue" text="—" styleClass="hero-kpi-value"/>
                    <Label fx:id="servicesDetail" styleClass="hero-kpi-detail"/>
                </VBox>
                <VBox styleClass="hero-kpi" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label text="SALDO POR PAGAR" styleClass="hero-kpi-caption"/>
                    <Label fx:id="pendingValue" text="—" styleClass="hero-kpi-value"/>
                    <Label fx:id="pendingDetail" styleClass="hero-kpi-detail"/>
                </VBox>
                <VBox styleClass="hero-kpi" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label text="PAGOS PENDIENTES" styleClass="hero-kpi-caption"/>
                    <Label fx:id="openValue" text="—" styleClass="hero-kpi-value"/>
                    <Label fx:id="openDetail" styleClass="hero-kpi-detail"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Buscador, ciudad, estado y Nueva funeraria aliada -->
        <HBox styleClass="filter-card">
            <HBox styleClass="search-box" HBox.hgrow="ALWAYS" minWidth="200">
                <SVGPath content="M7 1.5a5.5 5.5 0 1 1 0 11a5.5 5.5 0 0 1 0-11z M11.2 11.2 L15 15" styleClass="search-icon"/>
                <TextField fx:id="searchField" promptText="Buscar por nombre o NIT" HBox.hgrow="ALWAYS"/>
            </HBox>
            <ComboBox fx:id="cityFilter" styleClass="chip-combo" minWidth="-Infinity"/>
            <HBox styleClass="segmented" minWidth="-Infinity">
                <ToggleButton fx:id="allState" text="Todas" toggleGroup="$stateGroup" selected="true" styleClass="segment"/>
                <ToggleButton fx:id="upToDateState" text="Al día" toggleGroup="$stateGroup" styleClass="segment"/>
                <ToggleButton fx:id="balanceState" text="Con saldo" toggleGroup="$stateGroup" styleClass="segment"/>
                <ToggleButton fx:id="inactiveState" text="Inactivas" toggleGroup="$stateGroup" styleClass="segment"/>
            </HBox>
            <Button text="+  Nueva funeraria aliada" onAction="#onNewHome" styleClass="primary-button" minWidth="-Infinity"/>
        </HBox>

        <HBox alignment="BOTTOM_LEFT">
            <Label text="Funerarias de la red" styleClass="section-heading"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" styleClass="section-count"/>
        </HBox>

        <StackPane VBox.vgrow="ALWAYS">
            <ScrollPane fx:id="cardsScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="cards-scroll">
                <FlowPane fx:id="cardsPane" hgap="16" vgap="16">
                    <padding><Insets bottom="8" right="6"/></padding>
                </FlowPane>
            </ScrollPane>
            <Label fx:id="emptyLabel" styleClass="empty-board" wrapText="true" StackPane.alignment="TOP_LEFT"
                   visible="false" mouseTransparent="true"/>
        </StackPane>
    </VBox>

    <!-- Panel lateral de la funeraria -->
    <Region fx:id="veil" styleClass="drawer-veil" visible="false" onMouseClicked="#onCloseDrawer"/>
    <VBox fx:id="drawer" styleClass="drawer" StackPane.alignment="CENTER_RIGHT" visible="false"
          minWidth="460" prefWidth="460" maxWidth="460">
        <VBox fx:id="drawerHead" styleClass="drawer-head"/>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="drawer-scroll" VBox.vgrow="ALWAYS">
            <VBox fx:id="drawerBody" spacing="10" styleClass="drawer-body"/>
        </ScrollPane>
        <HBox fx:id="drawerActions" spacing="10" styleClass="drawer-footer"/>
    </VBox>

    <!-- Aviso corto al guardar; se desvanece solo -->
    <Label fx:id="toast" styleClass="toast" StackPane.alignment="BOTTOM_LEFT" wrapText="true" maxWidth="420">
        <StackPane.margin>
            <Insets bottom="24" left="24"/>
        </StackPane.margin>
    </Label>
</StackPane>
