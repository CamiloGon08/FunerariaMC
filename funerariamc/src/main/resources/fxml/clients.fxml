<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
  Módulo de Clientes (HU-01), propuesta P-11 / P-11.1: búsqueda, tipo y saldo, indicadores,
  tarjetas por titular con plan exequial, contratos y saldo, y panel lateral del cliente.
  Se muestra dentro del contentPane de main.fxml.
-->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="root" fx:controller="com.example.funerariamc.controller.ClientController"
           styleClass="personal-root" stylesheets="@../css/personal.css, @../css/clients.css">

    <fx:define>
        <ToggleGroup fx:id="typeGroup"/>
    </fx:define>

    <VBox spacing="18">
        <!-- Búsqueda, tipo, saldo y nuevo cliente (.filter-card y .search-box en app.css) -->
        <HBox styleClass="filter-card">
            <HBox styleClass="search-box" HBox.hgrow="ALWAYS" minWidth="180">
                <SVGPath content="M7 1.5a5.5 5.5 0 1 1 0 11a5.5 5.5 0 0 1 0-11z M11.2 11.2 L15 15" styleClass="search-icon"/>
                <TextField fx:id="searchField" promptText="Buscar por nombre o documento" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="5" alignment="CENTER_LEFT" minWidth="-Infinity">
                <ToggleButton fx:id="allToggle" text="Todos" toggleGroup="$typeGroup" selected="true"
                              styleClass="chip, area-chip" minWidth="-Infinity"/>
                <ToggleButton fx:id="naturalToggle" text="Persona natural" toggleGroup="$typeGroup"
                              styleClass="chip, area-chip" minWidth="-Infinity"/>
                <ToggleButton fx:id="corporateToggle" text="Empresa" toggleGroup="$typeGroup"
                              styleClass="chip, area-chip" minWidth="-Infinity"/>
            </HBox>
            <ComboBox fx:id="balanceFilter" styleClass="chip-combo" prefWidth="186" minWidth="186"/>
            <Button text="+  Nuevo cliente" onAction="#onRegister" styleClass="primary-button"
                    minWidth="-Infinity"/>
        </HBox>

        <!-- Indicadores -->
        <HBox spacing="16">
            <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label text="CLIENTES" styleClass="kpi-caption"/>
                <Label fx:id="totalValue" text="—" styleClass="kpi-value"/>
                <Label fx:id="totalDetail" styleClass="kpi-detail"/>
            </VBox>
            <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label text="CON PLAN EXEQUIAL ACTIVO" styleClass="kpi-caption"/>
                <Label fx:id="planValue" text="—" styleClass="kpi-value"/>
                <Label fx:id="planDetail" styleClass="kpi-detail"/>
            </VBox>
            <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label text="SALDO POR COBRAR" styleClass="kpi-caption"/>
                <Label fx:id="receivableValue" text="—" styleClass="kpi-value"/>
                <Label fx:id="receivableDetail" styleClass="kpi-detail, kpi-detail-gold"/>
            </VBox>
            <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label text="NUEVOS ESTE MES" styleClass="kpi-caption"/>
                <Label fx:id="newValue" text="—" styleClass="kpi-value"/>
                <Label fx:id="newDetail" styleClass="kpi-detail"/>
            </VBox>
        </HBox>

        <HBox alignment="BOTTOM_LEFT">
            <Label text="Clientes" styleClass="section-heading"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="showingLabel" styleClass="card-subtitle"/>
        </HBox>

        <!-- Tarjetas: barra de desplazamiento visible; se cargan 12 más al llegar al final -->
        <ScrollPane fx:id="cardScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS"
                    styleClass="card-scroll" VBox.vgrow="ALWAYS">
            <VBox spacing="16" styleClass="card-scroll-content">
                <GridPane fx:id="cardGrid" hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                    </columnConstraints>
                </GridPane>
                <Label fx:id="emptyLabel" text="No hay clientes que coincidan con la búsqueda."
                       styleClass="card-subtitle" managed="false" visible="false"/>
                <HBox alignment="CENTER">
                    <Button fx:id="moreButton" text="Mostrar más clientes" onAction="#onLoadMore"
                            styleClass="secondary-button" managed="false" visible="false"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </VBox>

    <!-- Panel del cliente (P-11.1): velo que oscurece la lista y panel a la derecha -->
    <Region fx:id="veil" styleClass="drawer-veil" visible="false" onMouseClicked="#onCloseDrawer"/>
    <VBox fx:id="drawer" styleClass="drawer" StackPane.alignment="CENTER_RIGHT"
          prefWidth="460" maxWidth="460" visible="false">
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="card-scroll" VBox.vgrow="ALWAYS">
            <VBox fx:id="drawerBody" spacing="14" styleClass="drawer-body"/>
        </ScrollPane>
        <HBox fx:id="drawerActions" spacing="10" styleClass="drawer-footer"/>
    </VBox>
</StackPane>
