<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Módulo de Clientes (HU-01, mockup 11). Se muestra dentro del contentPane de main.fxml. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.funerariamc.controller.ClientController"
      spacing="20" styleClass="personal-root" stylesheets="@../css/personal.css, @../css/clients.css">

    <fx:define>
        <ToggleGroup fx:id="typeGroup"/>
    </fx:define>

    <!-- Búsqueda y filtros: la misma cápsula de búsqueda de la bitácora y de Personal -->
    <HBox styleClass="filter-card">
        <HBox styleClass="search-box" HBox.hgrow="ALWAYS" minWidth="230">
            <SVGPath content="M7 1.5a5.5 5.5 0 1 1 0 11a5.5 5.5 0 0 1 0-11z M11.2 11.2 L15 15" styleClass="search-icon"/>
            <TextField fx:id="searchField" promptText="Buscar por nombre o documento" HBox.hgrow="ALWAYS"/>
        </HBox>
        <ToggleButton fx:id="allToggle" text="Todos" toggleGroup="$typeGroup" selected="true" styleClass="chip"/>
        <ToggleButton fx:id="naturalToggle" text="Natural" toggleGroup="$typeGroup" styleClass="chip"/>
        <ToggleButton fx:id="corporateToggle" text="Empresa" toggleGroup="$typeGroup" styleClass="chip"/>
        <Button text="+  Nuevo cliente" onAction="#onRegister" styleClass="primary-button"
                minWidth="-Infinity"/>
    </HBox>

    <!-- Tabla de clientes -->
    <VBox styleClass="table-card" spacing="2" VBox.vgrow="ALWAYS">
        <Label text="Clientes registrados" styleClass="card-title"/>
        <Label fx:id="countLabel" styleClass="card-subtitle"/>
        <TableView fx:id="clientTable" styleClass="employee-table" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets top="12"/>
            </VBox.margin>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="documentColumn" text="DOCUMENTO" prefWidth="115" minWidth="105"/>
                <TableColumn fx:id="nameColumn" text="NOMBRE / RAZÓN SOCIAL" prefWidth="210" minWidth="170"/>
                <TableColumn fx:id="typeColumn" text="TIPO" prefWidth="90" minWidth="85"/>
                <TableColumn fx:id="phoneColumn" text="TELÉFONO" prefWidth="115" minWidth="110"/>
                <TableColumn fx:id="addressColumn" text="DIRECCIÓN" prefWidth="170" minWidth="120"/>
                <TableColumn fx:id="registrationColumn" text="REGISTRO" prefWidth="90" minWidth="88"/>
                <TableColumn fx:id="actionsColumn" text="ACCIONES" prefWidth="150" minWidth="150" sortable="false"/>
            </columns>
            <placeholder>
                <Label text="No hay clientes que coincidan con la búsqueda." styleClass="card-subtitle"/>
            </placeholder>
        </TableView>
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="10"/>
            </padding>
            <Label fx:id="showingLabel" styleClass="card-subtitle"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Pagination fx:id="pagination" styleClass="log-pagination" pageCount="1" maxPageIndicatorCount="7"/>
        </HBox>
    </VBox>
</VBox>
