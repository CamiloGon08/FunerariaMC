<?xml version="1.0" encoding="UTF-8"?>

<?import com.example.funerariamc.controller.LilyLogo?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- "¿Olvidó su contraseña?" (RF-ACC-03): paso 1 pide el código, paso 2 lo valida y cambia la contraseña -->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.funerariamc.controller.PasswordRecoveryController"
      styleClass="login-root" prefWidth="1100" prefHeight="680"
      stylesheets="@../css/app.css">

    <!-- Panel de marca: igual al del login -->
    <VBox styleClass="login-brand" prefWidth="440" minWidth="440">
        <LilyLogo size="96"/>
        <Region prefHeight="6"/>
        <Label text="F U N E R A R I A" styleClass="brand-sub"/>
        <Label text="El Edén" styleClass="brand-name" wrapText="true"/>
        <Region styleClass="gold-rule"/>
        <Label text="Sistema de información para la gestión integral de servicios exequiales." styleClass="brand-tagline"
               wrapText="true"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Label text="“Acompañamos con respeto cada despedida.”" styleClass="brand-quote" wrapText="true"/>
        <Label text="VALLEDUPAR · CESAR" styleClass="brand-place"/>
    </VBox>

    <VBox styleClass="login-form" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
        <Label text="RECUPERAR ACCESO" styleClass="eyebrow"/>
        <Label text="Restablecer contraseña" styleClass="login-title" wrapText="true"/>
        <Label fx:id="stepLabel" styleClass="login-subtitle" wrapText="true"/>

        <!-- Paso 1: usuario -->
        <VBox fx:id="requestStep" spacing="6">
            <Label text="USUARIO" styleClass="field-label"/>
            <TextField fx:id="usernameField" promptText="Ingrese su usuario"/>
            <Region minHeight="10"/>
            <Button fx:id="sendCodeButton" text="Enviar código" onAction="#onSendCode"
                    defaultButton="true" maxWidth="Infinity" styleClass="primary-button"/>
        </VBox>

        <!-- Paso 2: código y nueva contraseña -->
        <VBox fx:id="resetStep" spacing="6" visible="false" managed="false">
            <Label text="CÓDIGO DE VERIFICACIÓN" styleClass="field-label"/>
            <TextField fx:id="codeField" promptText="6 dígitos"/>
            <Label text="NUEVA CONTRASEÑA" styleClass="field-label"/>
            <PasswordField fx:id="newPasswordField" promptText="Mínimo 8 caracteres"/>
            <Label text="CONFIRMAR CONTRASEÑA" styleClass="field-label"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Repita la nueva contraseña"/>
            <HBox alignment="CENTER_RIGHT">
                <Hyperlink fx:id="resendLink" text="Enviar otro código" onAction="#onResend" styleClass="link"/>
            </HBox>
            <Button fx:id="changePasswordButton" text="Cambiar contraseña" onAction="#onChangePassword"
                    defaultButton="true" maxWidth="Infinity" styleClass="primary-button"/>
        </VBox>

        <Label fx:id="infoLabel" styleClass="info-label" wrapText="true" minHeight="22"/>
        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" minHeight="22"/>

        <HBox alignment="CENTER_LEFT">
            <Hyperlink text="← Volver a iniciar sesión" onAction="#onBackToLogin" styleClass="link"/>
        </HBox>

        <Region minHeight="24"/>
        <Label text="Ingeniería de Software I · Unicesar · 2026" styleClass="login-footer"/>
    </VBox>
</HBox>
