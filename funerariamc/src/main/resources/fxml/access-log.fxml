<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Bitácora (RF-ACC-07) con paginación y filtros por fecha y usuario (RF-ACC-08).
     Se muestra dentro del contentPane de main.fxml -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.funerariamc.controller.AccessLogController"
      spacing="12">

    <!-- Filtros: búsqueda por usuario (estilo del módulo de Personal) y rango de fechas con calendario -->
    <HBox styleClass="filter-card">
        <HBox styleClass="search-box" HBox.hgrow="ALWAYS">
            <SVGPath content="M7 1.5a5.5 5.5 0 1 1 0 11a5.5 5.5 0 0 1 0-11z M11.2 11.2 L15 15" styleClass="search-icon"/>
            <TextField fx:id="userFilterField" promptText="Buscar por usuario o empleado"
                       onAction="#onFilter" HBox.hgrow="ALWAYS"/>
        </HBox>
        <DatePicker fx:id="fromDatePicker" prefWidth="175"/>
        <DatePicker fx:id="toDatePicker" prefWidth="175"/>
        <Button text="Filtrar" onAction="#onFilter" styleClass="primary-button"/>
        <Button text="Limpiar filtros" onAction="#onClearFilters" styleClass="secondary-button"/>
    </HBox>
    <Label fx:id="filterErrorLabel" styleClass="error-label"/>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="countLabel" styleClass="placeholder"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ToggleButton fx:id="showIpButton"/>
        <Button text="Actualizar" onAction="#onRefresh" styleClass="primary-button"/>
    </HBox>

    <TableView fx:id="logTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <placeholder>
            <Label fx:id="emptyLabel" text="Aún no hay registros en la bitácora." styleClass="placeholder"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="dateColumn" text="Fecha y hora" prefWidth="170"/>
            <TableColumn fx:id="userColumn" text="Usuario" prefWidth="110"/>
            <TableColumn fx:id="employeeColumn" text="Empleado" prefWidth="170"/>
            <TableColumn fx:id="actionColumn" text="Acción" prefWidth="330"/>
            <TableColumn fx:id="ipColumn" text="IP" prefWidth="130"/>
        </columns>
    </TableView>

    <!-- Solo la barra de páginas: la tabla de arriba es la que cambia -->
    <Pagination fx:id="pagination" styleClass="log-pagination" pageCount="1" maxPageIndicatorCount="7"/>
</VBox>
