<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Bitácora (RF-ACC-07) con paginación. Se muestra dentro del contentPane de main.fxml -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.funerariamc.controller.AccessLogController"
      spacing="12">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="countLabel" styleClass="placeholder"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ToggleButton fx:id="showIpButton"/>
        <Button text="Actualizar" onAction="#onRefresh" styleClass="primary-button"/>
    </HBox>

    <TableView fx:id="logTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="Aún no hay registros en la bitácora." styleClass="placeholder"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="dateColumn" text="Fecha y hora" prefWidth="170"/>
            <TableColumn fx:id="userColumn" text="Usuario" prefWidth="140"/>
            <TableColumn fx:id="actionColumn" text="Acción" prefWidth="320"/>
            <TableColumn fx:id="ipColumn" text="IP" prefWidth="130"/>
        </columns>
    </TableView>

    <!-- Solo la barra de páginas: la tabla de arriba es la que cambia -->
    <Pagination fx:id="pagination" styleClass="log-pagination" pageCount="1" maxPageIndicatorCount="7"/>
</VBox>
