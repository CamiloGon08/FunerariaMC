<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
  Mensajes del bot (Administrador Maestro y Secretaría): lo que el bot de Telegram respondió a cada
  titular y los correos de bienvenida al afiliar un plan. Solo lectura: desde aquí no se envía nada.
  Banda verde con 4 indicadores, buscador y filtros, lista de conversaciones a la izquierda y el chat
  a la derecha. Se muestra dentro del contentPane de main.fxml (RefreshableView) y se actualiza sola
  cuando llega un mensaje nuevo.
-->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="root" fx:controller="com.example.funerariamc.controller.BotMessagesController"
           styleClass="personal-root,bot-root" stylesheets="@../css/personal.css, @../css/bot-messages.css">

    <fx:define>
        <ToggleGroup fx:id="filterGroup"/>
    </fx:define>

    <ScrollPane fx:id="pageScroll" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                styleClass="card-scroll,page-scroll">
        <VBox spacing="16" styleClass="page-content">
            <!-- Banda verde: arriba el encabezado del menú (MainController lo pone en #heroHeaderSlot) -->
            <VBox styleClass="hero-band" spacing="18">
                <StackPane id="heroHeaderSlot" alignment="TOP_LEFT"/>
                <HBox spacing="16">
                    <VBox styleClass="hero-kpi" HBox.hgrow="ALWAYS" prefWidth="0">
                        <Label text="MENSAJES HOY" styleClass="hero-kpi-caption"/>
                        <Label fx:id="todayValue" text="—" styleClass="hero-kpi-value"/>
                        <Label fx:id="todayDetail" styleClass="hero-kpi-detail"/>
                    </VBox>
                    <VBox styleClass="hero-kpi" HBox.hgrow="ALWAYS" prefWidth="0">
                        <Label text="CONSULTAS HOY" styleClass="hero-kpi-caption"/>
                        <Label fx:id="queriesValue" text="—" styleClass="hero-kpi-value"/>
                        <Label fx:id="queriesDetail" styleClass="hero-kpi-detail"/>
                    </VBox>
                    <VBox styleClass="hero-kpi" HBox.hgrow="ALWAYS" prefWidth="0">
                        <Label text="BIENVENIDAS DEL MES" styleClass="hero-kpi-caption"/>
                        <Label fx:id="welcomeValue" text="—" styleClass="hero-kpi-value"/>
                        <Label fx:id="welcomeDetail" styleClass="hero-kpi-detail"/>
                    </VBox>
                    <VBox styleClass="hero-kpi" HBox.hgrow="ALWAYS" prefWidth="0">
                        <Label text="ENVÍOS FALLIDOS DEL MES" styleClass="hero-kpi-caption"/>
                        <Label fx:id="failedValue" text="—" styleClass="hero-kpi-value"/>
                        <Label fx:id="failedDetail" styleClass="hero-kpi-detail"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Buscador, filtros, estado del bot en este equipo y actualizar -->
            <HBox styleClass="filter-card">
                <HBox styleClass="search-box" HBox.hgrow="ALWAYS" minWidth="200">
                    <SVGPath content="M7 1.5a5.5 5.5 0 1 1 0 11a5.5 5.5 0 0 1 0-11z M11.2 11.2 L15 15" styleClass="search-icon"/>
                    <TextField fx:id="searchField" promptText="Buscar titular o cédula" HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox styleClass="segmented" minWidth="-Infinity">
                    <ToggleButton fx:id="allFilter" text="Todas" toggleGroup="$filterGroup" selected="true" styleClass="segment"/>
                    <ToggleButton fx:id="queriesFilter" text="Consultas" toggleGroup="$filterGroup" styleClass="segment"/>
                    <ToggleButton fx:id="welcomeFilter" text="Bienvenidas" toggleGroup="$filterGroup" styleClass="segment"/>
                    <ToggleButton fx:id="failedFilter" text="Fallidos" toggleGroup="$filterGroup" styleClass="segment"/>
                </HBox>
                <Label fx:id="botStatus" styleClass="bot-status" minWidth="-Infinity"/>
                <Button text="Actualizar" onAction="#onRefresh" styleClass="secondary-button" minWidth="-Infinity"/>
            </HBox>

            <!-- Conversaciones y chat: cada uno con su propio scroll -->
            <HBox spacing="16" VBox.vgrow="ALWAYS" minHeight="560">
                <VBox styleClass="table-card,conversation-card" spacing="10" minWidth="320" prefWidth="380" maxWidth="420">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Conversaciones" styleClass="card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="countLabel" styleClass="card-subtitle"/>
                    </HBox>
                    <StackPane VBox.vgrow="ALWAYS">
                        <ListView fx:id="conversationList" styleClass="conversation-list"/>
                        <Label fx:id="listEmpty" styleClass="empty-board" wrapText="true" visible="false"
                               mouseTransparent="true" StackPane.alignment="TOP_LEFT"/>
                    </StackPane>
                </VBox>

                <VBox styleClass="table-card,chat-card" HBox.hgrow="ALWAYS" spacing="0">
                    <HBox styleClass="chat-head" alignment="CENTER_LEFT" spacing="12">
                        <StackPane fx:id="chatAvatar" styleClass="chat-avatar"/>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label fx:id="chatTitle" text="Seleccione una conversación" styleClass="chat-title"/>
                            <Label fx:id="chatSubtitle" styleClass="chat-subtitle"/>
                        </VBox>
                        <Label text="Solo lectura" styleClass="read-only-chip"/>
                    </HBox>
                    <StackPane VBox.vgrow="ALWAYS">
                        <ScrollPane fx:id="threadScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="thread-scroll">
                            <VBox fx:id="threadBox" spacing="10" styleClass="thread-box"/>
                        </ScrollPane>
                        <Label fx:id="threadEmpty" styleClass="thread-empty" wrapText="true" visible="false" mouseTransparent="true"/>
                    </StackPane>
                    <HBox styleClass="chat-foot" alignment="CENTER_LEFT" spacing="10">
                        <SVGPath content="M12 2a10 10 0 1 1 0 20a10 10 0 0 1 0-20z M12 16v-4 M12 8h.01" styleClass="note-icon"/>
                        <Label text="Esta pantalla no envía mensajes. El bot responde solo, con los datos del sistema, y pide cédula y código en cada consulta."
                               wrapText="true" styleClass="chat-foot-text" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
</StackPane>
