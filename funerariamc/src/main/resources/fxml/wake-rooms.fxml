<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Módulo Salas de velación, tablero 19 y panel 19.1 de Figma con la
  paleta verde oscura (captura 07_salas): banda verde con el título y 4 indicadores, fecha
  consultada con flechas y "Hoy", filtro por estado, una tarjeta por sala y panel lateral.
  Se muestra dentro del contentPane de main.fxml. El menú la guarda abierta (RefreshableView).
-->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="root" fx:controller="com.example.funerariamc.controller.WakeRoomController"
           styleClass="personal-root,wake-root" stylesheets="@../css/personal.css, @../css/wake-rooms.css">

    <fx:define>
        <ToggleGroup fx:id="stateGroup"/>
    </fx:define>

    <VBox spacing="16">
        <!-- Banda verde: arriba el encabezado del menú (MainController lo pone en #heroHeaderSlot) -->
        <VBox styleClass="hero-band" spacing="18">
            <StackPane id="heroHeaderSlot" alignment="TOP_LEFT"/>
            <HBox spacing="16">
                <VBox styleClass="hero-kpi,highlight" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label fx:id="occupiedCaption" text="OCUPADAS AHORA" styleClass="hero-kpi-caption"/>
                    <Label fx:id="occupiedValue" text="—" styleClass="hero-kpi-value"/>
                    <Label fx:id="occupiedDetail" styleClass="hero-kpi-detail"/>
                </VBox>
                <VBox styleClass="hero-kpi" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label fx:id="reservedCaption" text="RESERVADAS HOY" styleClass="hero-kpi-caption"/>
                    <Label fx:id="reservedValue" text="—" styleClass="hero-kpi-value"/>
                    <Label fx:id="reservedDetail" styleClass="hero-kpi-detail"/>
                </VBox>
                <VBox styleClass="hero-kpi" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label text="DISPONIBLES" styleClass="hero-kpi-caption"/>
                    <Label fx:id="availableValue" text="—" styleClass="hero-kpi-value"/>
                    <Label text="listas para asignar" styleClass="hero-kpi-detail"/>
                </VBox>
                <VBox styleClass="hero-kpi" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label fx:id="departuresCaption" text="SALIDAS HOY" styleClass="hero-kpi-caption"/>
                    <Label fx:id="departuresValue" text="—" styleClass="hero-kpi-value"/>
                    <Label fx:id="departuresDetail" styleClass="hero-kpi-detail"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Fecha consultada, filtro por estado y Nueva sala -->
        <HBox styleClass="filter-card">
            <Button text="‹" onAction="#onPreviousDay" styleClass="day-arrow" minWidth="-Infinity"/>
            <DatePicker fx:id="datePicker" prefWidth="260" minWidth="200" editable="false"/>
            <Button text="›" onAction="#onNextDay" styleClass="day-arrow" minWidth="-Infinity"/>
            <Button text="Hoy" onAction="#onToday" styleClass="today-button" minWidth="-Infinity"/>
            <HBox styleClass="segmented" minWidth="-Infinity">
                <ToggleButton fx:id="allToggle" text="Todas" toggleGroup="$stateGroup" selected="true" styleClass="segment"/>
                <ToggleButton fx:id="inWakeToggle" text="Ocupadas" toggleGroup="$stateGroup" styleClass="segment"/>
                <ToggleButton fx:id="reservedToggle" text="Reservadas" toggleGroup="$stateGroup" styleClass="segment"/>
                <ToggleButton fx:id="availableToggle" text="Disponibles" toggleGroup="$stateGroup" styleClass="segment"/>
            </HBox>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="newRoomButton" text="+  Nueva sala" onAction="#onNewRoom" styleClass="primary-button" minWidth="-Infinity"/>
        </HBox>

        <!-- Tarjetas de las salas con barra de desplazamiento visible (sin paginación) -->
        <ScrollPane fx:id="cardScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS"
                    styleClass="card-scroll" VBox.vgrow="ALWAYS">
            <VBox styleClass="card-scroll-content" spacing="10">
                <GridPane fx:id="cardGrid" hgap="18" vgap="18"/>
                <Label fx:id="emptyLabel" styleClass="empty-board" wrapText="true" managed="false" visible="false"/>
            </VBox>
        </ScrollPane>
    </VBox>

    <!-- Panel de detalle de la velación (19.1) -->
    <Region fx:id="veil" styleClass="drawer-veil" visible="false" onMouseClicked="#onCloseDrawer"/>
    <VBox fx:id="drawer" styleClass="drawer" StackPane.alignment="CENTER_RIGHT"
          prefWidth="480" maxWidth="480" visible="false">
        <VBox fx:id="drawerHead" styleClass="drawer-head"/>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="card-scroll" VBox.vgrow="ALWAYS">
            <VBox fx:id="drawerBody" spacing="12" styleClass="drawer-body"/>
        </ScrollPane>
        <HBox fx:id="drawerActions" spacing="10" styleClass="drawer-footer"/>
    </VBox>

    <!-- Aviso corto al guardar; se desvanece solo -->
    <Label fx:id="toast" styleClass="toast" StackPane.alignment="BOTTOM_LEFT" wrapText="true" maxWidth="420">
        <StackPane.margin>
            <Insets bottom="24" left="24"/>
        </StackPane.margin>
    </Label>
</StackPane>
